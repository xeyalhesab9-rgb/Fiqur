<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Warzone Squad: Merge & Conquer</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #121619;
            color: #fff;
            font-family: 'Segoe UI', Arial, sans-serif;
            text-align: center;
            display: flex;
            flex-direction: column;
            height: 100vh;
            justify-content: space-between;
            padding: 15px;
            user-select: none;
        }
        .header {
            background: #1e252b;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #333;
        }
        .stats {
            display: flex;
            justify-content: space-around;
            margin-top: 10px;
        }
        .stat-val { font-size: 20px; font-weight: bold; color: #ffcc00; }
        
        /* Grid / Baza Sahəsi */
        .grid-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin: 20px 0;
        }
        .slot {
            aspect-ratio: 1;
            background: #2a323d;
            border: 2px dashed #444;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            cursor: pointer;
            position: relative;
        }
        .slot.active {
            border: 2px solid #ff4500;
            background: #332020;
        }
        .level-badge {
            position: absolute;
            bottom: 5px;
            right: 5px;
            font-size: 11px;
            background: #ff4500;
            padding: 2px 6px;
            border-radius: 6px;
            font-weight: bold;
        }

        /* Düymələr və Menyu */
        .controls { display: flex; flex-direction: column; gap: 10px; }
        .btn {
            background: #28a745;
            color: white;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .btn:active { transform: scale(0.98); }
        .btn-ad { background: #e67e22; }
    </style>
</head>
<body>

    <!-- Üst Stat Paneli -->
    <div class="header">
        <h3>🪖 WARZONE SQUAD</h3>
        <div class="stats">
            <div>Qızıl:<br><span id="gold" class="stat-val">100</span> 🪙</div>
            <div>Gəlir/san:<br><span id="income" class="stat-val">0</span> /s</div>
        </div>
    </div>

    <!-- 3x3 Döyüşçü Bazasının Toru -->
    <div class="grid-container" id="grid">
        <!-- 9 Slot JS ilə dolacaq -->
    </div>

    <!-- İdarəetmə Düymələri (Qazanc və Yüksəltmə) -->
    <div class="controls">
        <button class="btn" onclick="buySoldier()">🪖 Əsgər Al (<span id="buyCost">50</span> Qızıl)</button>
        <button class="btn btn-ad" onclick="watchAd()">📺 Reklama Bax (+500 Qızıl)</button>
    </div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        let gold = 100;
        let buyCost = 50;
        let selectedSlot = null;

        // Əsgər Səviyyələri və İkonları
        const units = {
            1: { name: "Piyada", icon: "🪖", income: 1 },
            2: { name: "Snayper", icon: "🥷", income: 3 },
            3: { name: "Pulemyotçu", icon: "💥", income: 8 },
            4: { name: "Zirehli Maşın", icon: "🏎️", income: 20 },
            5: { name: "Tank", icon: "🛞", income: 50 },
            6: { name: "Helikopter", icon: "🚁", income: 120 }
        };

        // 9 slotlu baza (0 = boş)
        let slots = [1, 0, 0, 0, 0, 0, 0, 0, 0];

        function renderGrid() {
            const gridEl = document.getElementById("grid");
            gridEl.innerHTML = "";
            let totalIncome = 0;

            slots.forEach((lvl, idx) => {
                const slotEl = document.createElement("div");
                slotEl.className = `slot ${selectedSlot === idx ? 'active' : ''}`;
                
                if (lvl > 0) {
                    slotEl.innerHTML = `${units[lvl].icon} <span class="level-badge">Lv.${lvl}</span>`;
                    totalIncome += units[lvl].income;
                }

                slotEl.onclick = () => handleSlotClick(idx);
                gridEl.appendChild(slotEl);
            });

            document.getElementById("gold").innerText = Math.floor(gold);
            document.getElementById("income").innerText = totalIncome;
            document.getElementById("buyCost").innerText = buyCost;
            return totalIncome;
        }

        // Birləşdirmə (Merge) Mexanikası
        function handleSlotClick(idx) {
            if (selectedSlot === null) {
                if (slots[idx] > 0) selectedSlot = idx;
            } else {
                if (selectedSlot === idx) {
                    selectedSlot = null; // Seçimi ləğv et
                } else if (slots[selectedSlot] === slots[idx] && slots[idx] > 0) {
                    // Eyni səviyyəli 2 əsgəri birləşdirib növbəti səviyyəyə qaldırırıq
                    if (slots[idx] < 6) {
                        slots[idx] += 1;
                        slots[selectedSlot] = 0;
                    }
                    selectedSlot = null;
                } else {
                    selectedSlot = slots[idx] > 0 ? idx : null;
                }
            }
            renderGrid();
        }

        // Yeni Əsgər Almaq
        function buySoldier() {
            const emptyIdx = slots.indexOf(0);
            if (emptyIdx === -1) {
                alert("Bazada boş yer yoxdur!");
                return;
            }
            if (gold >= buyCost) {
                gold -= buyCost;
                slots[emptyIdx] = 1;
                buyCost = Math.floor(buyCost * 1.3); // Hər dəfə qiymət artır
                renderGrid();
            } else {
                alert("Kifayət qədər qızılınız yoxdur!");
            }
        }

        // Reklam İnteqrasiya Sahəsi (Monetizasiya)
        function watchAd() {
            // Gələcəkdə Adsgram SDK bura qoşulacaq
            alert("Reklam nümayiş olunur... +500 Qızıl qazandınız!");
            gold += 500;
            renderGrid();
        }

        // Avtomatik Passiv Qazanc (Saniyədə bir)
        setInterval(() => {
            const inc = renderGrid();
            gold += inc;
            document.getElementById("gold").innerText = Math.floor(gold);
        }, 1000);

        renderGrid();
    </script>
</body>
</html>
